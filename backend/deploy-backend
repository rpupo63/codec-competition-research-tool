#!/bin/bash
set -e

HEALTH_URL="https://api.distro-interview.xyz/healthcheck"
MAX_RETRIES=10
RETRY_DELAY=2
# Define variables to keep things consistent
REMOTE_USER="svc-distro-interview" 
SERVICE_NAME="distro-interview"

echo "Building production binary..."
# Note: Since you're on Arch (likely x86_64) and RackNerd is likely Linux/AMD64, 
# this is usually fine, but adding GOOS/GOARCH ensures compatibility.
GOOS=linux GOARCH=amd64 go build -ldflags="-s -w" -o server .

echo "Uploading to racknerd-backend..."
scp server racknerd-backend:~

echo "Installing binary and restarting service..."
ssh racknerd-backend "
    sudo systemctl stop $SERVICE_NAME
    sudo mv ~/server /opt/distro-interview/server
    # Use the correct user from your service file
    sudo chown $REMOTE_USER:$REMOTE_USER /opt/distro-interview/server
    sudo chmod +x /opt/distro-interview/server
    sudo systemctl daemon-reload
    sudo systemctl restart $SERVICE_NAME
"

echo "Checking deployment health at $HEALTH_URL..."
for i in $(seq 1 $MAX_RETRIES); do
    if curl -sf "$HEALTH_URL" > /dev/null 2>&1; then
        echo "Health check passed!"
        curl -s "$HEALTH_URL" | jq .
        echo "Deploy complete!"
        exit 0
    fi
    echo "Attempt $i/$MAX_RETRIES - waiting ${RETRY_DELAY}s..."
    sleep $RETRY_DELAY
done

echo "Health check failed after $MAX_RETRIES attempts!"
echo "Checking service status..."
ssh racknerd-backend 'sudo systemctl status distro-interview'
exit 1
