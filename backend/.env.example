PORT=8080
ACCEPTED_ORIGINS=http://localhost:5173

# Supabase PostgreSQL connection string. Replace with your actual Supabase credentials.
# You can find this in your Supabase Project Settings -> Database -> Connection string.
# Example: postgresql://postgres:[YOUR-PASSWORD]@[YOUR-SUPABASE-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL="postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?sslmode=require"

# Strategy Agent — required for live competitive research pipeline
GEMINI_API_KEY=your_gemini_api_key_here       # Gemini Flash (LLM calls — steps 0, 4, 5)
ENRICH_API_KEY=your_enrich_api_key_here       # EnrichLayer (company + competitor data — steps 1 & 2)
SERP_API_KEY=your_serp_api_key_here           # SerpAPI (Google search snippets — step 3)
